<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_lae_lease_field_tree" model="ir.ui.view">
            <field name="name">lae.lease.field.tree</field>
            <field name="model">lae.lease.field</field>
            <field name="arch" type="xml">
                <tree string="Extracted Fields">
                    <field name="name"/>
                    <field name="job_id"/>
                    <field name="field_category"/>
                    <field name="field_name"/>
                    <field name="field_value"/>
                    <field name="confidence" widget="percentage"/>
                    <field name="page_reference"/>
                    <field name="verified" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_lae_lease_field_form" model="ir.ui.view">
            <field name="name">lae.lease.field.form</field>
            <field name="model">lae.lease.field</field>
            <field name="arch" type="xml">
                <form string="Extracted Lease Field">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="job_id"/>
                                <field name="field_category"/>
                                <field name="field_name"/>
                            </group>
                            <group>
                                <field name="confidence" widget="percentage"/>
                                <field name="page_reference"/>
                                <field name="verified" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group>
                            <field name="field_value"/>
                            <field name="corrected_value"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_lae_lease_field" model="ir.actions.act_window">
            <field name="name">Extracted Fields</field>
            <field name="res_model">lae.lease.field</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No extracted fields found
                </p>
            </field>
        </record>
    </data>
</odoo>
