<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_lae_lease_comparison_tree" model="ir.ui.view">
            <field name="name">lae.lease.comparison.tree</field>
            <field name="model">lae.lease.comparison</field>
            <field name="arch" type="xml">
                <list string="Lease Comparisons">
                    <field name="name"/>
                    <field name="lease_a_id"/>
                    <field name="lease_b_id"/>
                    <field name="comparison_type"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_lae_lease_comparison_form" model="ir.ui.view">
            <field name="name">lae.lease.comparison.form</field>
            <field name="model">lae.lease.comparison</field>
            <field name="arch" type="xml">
                <form string="Lease Comparison">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="lease_a_id"/>
                                <field name="lease_b_id"/>
                                <field name="comparison_type"/>
                            </group>
                        </group>
                        <group>
                            <field name="differences"/>
                            <field name="ai_favorability"/>
                            <field name="recommendation"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_lae_lease_comparison" model="ir.actions.act_window">
            <field name="name">Lease Comparison</field>
            <field name="res_model">lae.lease.comparison</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new lease comparison
                </p>
            </field>
        </record>
    </data>
</odoo>
