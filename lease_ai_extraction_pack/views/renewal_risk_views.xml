<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_lae_renewal_risk_tree" model="ir.ui.view">
            <field name="name">lae.renewal.risk.tree</field>
            <field name="model">lae.renewal.risk</field>
            <field name="arch" type="xml">
                <tree string="Renewal Risk Assessments"
                      decoration-success="risk_level == 'low'"
                      decoration-info="risk_level == 'medium'"
                      decoration-warning="risk_level == 'high'"
                      decoration-danger="risk_level == 'critical'">
                    <field name="name"/>
                    <field name="lease_id"/>
                    <field name="tenant_id"/>
                    <field name="expiry_date"/>
                    <field name="days_until_expiry"/>
                    <field name="ai_renewal_probability" widget="percentage"/>
                    <field name="risk_level" widget="badge"
                           decoration-success="risk_level == 'low'"
                           decoration-info="risk_level == 'medium'"
                           decoration-warning="risk_level == 'high'"
                           decoration-danger="risk_level == 'critical'"/>
                    <field name="ai_recommendation"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_lae_renewal_risk_form" model="ir.ui.view">
            <field name="name">lae.renewal.risk.form</field>
            <field name="model">lae.renewal.risk</field>
            <field name="arch" type="xml">
                <form string="Renewal Risk Assessment">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="lease_id"/>
                                <field name="tenant_id"/>
                                <field name="expiry_date"/>
                                <field name="days_until_expiry"/>
                            </group>
                            <group>
                                <field name="ai_renewal_probability" widget="percentage"/>
                                <field name="risk_level"
                                       decoration-success="risk_level == 'low'"
                                       decoration-info="risk_level == 'medium'"
                                       decoration-warning="risk_level == 'high'"
                                       decoration-danger="risk_level == 'critical'"/>
                                <field name="ai_recommendation"/>
                                <field name="tenant_payment_history_score"/>
                            </group>
                        </group>
                        <group>
                            <field name="market_rent_comparison"/>
                            <field name="risk_factors"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_lae_renewal_risk" model="ir.actions.act_window">
            <field name="name">Renewal Risk</field>
            <field name="res_model">lae.renewal.risk</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new renewal risk assessment
                </p>
            </field>
        </record>
    </data>
</odoo>
