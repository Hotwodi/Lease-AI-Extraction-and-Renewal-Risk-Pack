<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_lae_extraction_job_tree" model="ir.ui.view">
            <field name="name">lae.extraction.job.tree</field>
            <field name="model">lae.extraction.job</field>
            <field name="arch" type="xml">
                <tree string="Extraction Jobs">
                    <field name="name"/>
                    <field name="document_type"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'uploaded'"
                           decoration-warning="state == 'processing'"
                           decoration-success="state == 'completed'"
                           decoration-danger="state == 'failed'"
                           decoration-primary="state == 'reviewed'"/>
                    <field name="ai_confidence" widget="percentage"/>
                    <field name="page_count"/>
                    <field name="extracted_field_count"/>
                    <field name="created_by"/>
                    <field name="created_date"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_lae_extraction_job_form" model="ir.ui.view">
            <field name="name">lae.extraction.job.form</field>
            <field name="model">lae.extraction.job</field>
            <field name="arch" type="xml">
                <form string="Extraction Job">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="uploaded,processing,completed,reviewed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="document_type"/>
                                <field name="document_file" filename="document_filename"/>
                                <field name="document_filename" invisible="1"/>
                                <field name="ai_confidence" widget="percentage"/>
                            </group>
                            <group>
                                <field name="page_count"/>
                                <field name="extracted_field_count"/>
                                <field name="created_by"/>
                                <field name="created_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Extracted Fields" name="extracted_fields">
                                <field name="field_ids">
                                    <tree editable="bottom">
                                        <field name="field_category"/>
                                        <field name="field_name"/>
                                        <field name="field_value"/>
                                        <field name="confidence" widget="percentage"/>
                                        <field name="page_reference"/>
                                        <field name="verified"/>
                                        <field name="corrected_value"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_lae_extraction_job" model="ir.actions.act_window">
            <field name="name">Extraction Jobs</field>
            <field name="res_model">lae.extraction.job</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new extraction job
                </p>
            </field>
        </record>
    </data>
</odoo>
